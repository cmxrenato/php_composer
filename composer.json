{
    "name": "renato/composer",
    "description": "Estudando o Composer",
    "type": "project",
    "autoload":{
        "psr-4":{
            "App\\":"src/"
        }
    },
    "authors": [
        {
            "name": "cmxrenato",
            "email": "renatoaraujoleal@gmail.com"
        }
    ],
    "require": {
        "mpdf/mpdf": "^8.0"
    },

    "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11",       // análise estática
    "friendsofphp/php-cs-fixer": "^3.0",  // formatador de código
    "phpunit/phpunit": "^10.0"        // testes automatizados
  },
  "scripts": {
    "analyse": "phpstan analyse src",
    "fix": "php-cs-fixer fix"
  }



}
